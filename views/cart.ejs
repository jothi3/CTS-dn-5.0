<%- include('partials/header') %>

<h1 style="font-size: 2rem; font-weight: 800; color: var(--dark); margin-bottom: 1.5rem;">Shopping Cart</h1>

<% if (!cartSummary || cartSummary.items.length === 0) { %>
  <div style="text-align: center; padding: 4rem 1rem; background: white; border-radius: var(--radius); border: 1px solid var(--border);">
    <i class="fa-solid fa-cart-flatbed" style="font-size: 4rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
    <h2>Your cart is currently empty</h2>
    <p style="color: var(--text-muted); margin-top: 0.5rem;">Browse our pharmacy catalog to add medicines and wellness products.</p>
    <a href="/products" class="btn-primary" style="margin-top: 1.5rem;">Explore Catalog</a>
  </div>
<% } else { %>
  <div style="display: flex; gap: 2rem; flex-wrap: wrap;">
    <div style="flex: 2; min-width: 320px;">
      <div style="background: white; border-radius: var(--radius); border: 1px solid var(--border); overflow: hidden;">
        <% cartSummary.items.forEach((item, index) => { %>
          <div style="display: flex; gap: 1.5rem; padding: 1.5rem; border-bottom: 1px solid var(--border); align-items: center;">
            <img src="<%= item.product.image_url %>" alt="<%= item.product.name %>" style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px;">
            
            <div style="flex: 1;">
              <span class="product-brand"><%= item.product.brand %></span>
              <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--dark);"><%= item.product.name %></h3>
              <p style="font-size: 0.85rem; color: var(--text-muted);"><%= item.product.dosage %></p>
              <div style="font-weight: 700; margin-top: 0.25rem;">₹<%= item.product.price %> each</div>
            </div>

            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <form action="/cart/update" method="POST" style="display: flex; align-items: center; border: 1px solid var(--border); border-radius: 6px; overflow: hidden;">
                <input type="hidden" name="productId" value="<%= item.product.id %>">
                <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="10" onchange="this.form.submit()" style="width: 60px; padding: 0.4rem; border: none; text-align: center; font-weight: 700;">
              </form>

              <form action="/cart/remove" method="POST">
                <input type="hidden" name="productId" value="<%= item.product.id %>">
                <button type="submit" style="background: transparent; border: none; color: #ef4444; cursor: pointer; padding: 0.5rem; font-size: 1.1rem;"><i class="fa-solid fa-trash-can"></i></button>
              </form>
            </div>

            <div style="font-size: 1.2rem; font-weight: 800; min-width: 90px; text-align: right; color: var(--dark);">
              ₹<%= item.product.price * item.quantity %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div style="flex: 1; min-width: 300px;">
      <div style="background: white; border-radius: var(--radius); border: 1px solid var(--border); padding: 1.5rem; position: sticky; top: 90px;">
        <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border);">Order Summary</h3>
        
        <form action="/cart/apply-coupon" method="POST" style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem;">
          <input type="text" name="couponCode" placeholder="Promo code (HEALTH20)" value="<%= cartSummary.couponCode || '' %>" style="flex: 1; padding: 0.6rem; border: 1px solid var(--border); border-radius: 6px; outline: none; font-size: 0.9rem;">
          <button type="submit" class="btn-secondary" style="padding: 0.6rem 1rem;">Apply</button>
        </form>

        <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.95rem;">
          <span>Subtotal</span>
          <span>₹<%= cartSummary.subtotal %></span>
        </div>

        <% if (cartSummary.discount > 0) { %>
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.95rem; color: #059669; font-weight: 600;">
            <span>Discount (HEALTH20 -20%)</span>
            <span>-₹<%= cartSummary.discount %></span>
          </div>
        <% } %>

        <div style="display: flex; justify-content: space-between; margin-bottom: 1.25rem; font-size: 0.95rem;">
          <span>Delivery Fee</span>
          <span><%= cartSummary.shipping === 0 ? 'FREE' : '₹' + cartSummary.shipping %></span>
        </div>

        <div style="display: flex; justify-content: space-between; padding-top: 1rem; border-top: 2px dashed var(--border); font-size: 1.3rem; font-weight: 800; color: var(--dark); margin-bottom: 1.5rem;">
          <span>Total Amount</span>
          <span>₹<%= cartSummary.total %></span>
        </div>

        <a href="/checkout" class="btn-primary" style="width: 100%; justify-content: center; padding: 0.85rem;"><i class="fa-solid fa-shield-check"></i> Proceed To Checkout</a>
      </div>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
