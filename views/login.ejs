<%- include('partials/header') %>

<div class="auth-container">
  <h1 class="auth-title">Welcome Back</h1>
  <p class="auth-subtitle">Sign in to manage your prescriptions and orders.</p>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert-danger"><%= error %></div>
  <% } %>

  <form action="/login" method="POST">
    <div class="form-group">
      <label class="form-label">Email Address</label>
      <input type="email" name="email" class="form-input" placeholder="you@example.com" required>
    </div>

    <div class="form-group">
      <label class="form-label">Password</label>
      <input type="password" name="password" class="form-input" placeholder="••••••••" required>
    </div>

    <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; padding: 0.85rem; margin-top: 1rem;">
      <i class="fa-solid fa-right-to-bracket"></i> Sign In
    </button>
  </form>

  <p style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-muted);">
    Don't have an account? <a href="/register" style="font-weight: 700;">Create one now</a>
  </p>
</div>

<%- include('partials/footer') %>
