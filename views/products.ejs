<%- include('partials/header') %>

<div style="margin-bottom: 2rem;">
  <h1 style="font-size: 2rem; font-weight: 800; color: var(--dark); margin-bottom: 0.5rem;">Pharmacy Catalog</h1>
  <p style="color: var(--text-muted);">Explore our range of 100% authentic medications, health supplements, and clinical supplies.</p>
</div>

<div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2rem;">
  <a href="/products" class="btn-secondary <%= currentCategory === 'all' ? 'active-filter' : '' %>">All Categories</a>
  <a href="/products?category=pain-relief" class="btn-secondary <%= currentCategory === 'pain-relief' ? 'active-filter' : '' %>">Pain & Fever</a>
  <a href="/products?category=antibiotics" class="btn-secondary <%= currentCategory === 'antibiotics' ? 'active-filter' : '' %>">Antibiotics</a>
  <a href="/products?category=vitamins" class="btn-secondary <%= currentCategory === 'vitamins' ? 'active-filter' : '' %>">Vitamins</a>
  <a href="/products?category=diabetes-cardiac" class="btn-secondary <%= currentCategory === 'diabetes-cardiac' ? 'active-filter' : '' %>">Diabetes & Heart</a>
  <a href="/products?category=digestive" class="btn-secondary <%= currentCategory === 'digestive' ? 'active-filter' : '' %>">Digestive</a>
  <a href="/products?category=personal-care" class="btn-secondary <%= currentCategory === 'personal-care' ? 'active-filter' : '' %>">Personal Care</a>
</div>

<% if (products.length === 0) { %>
  <div style="text-align: center; padding: 4rem 1rem; background: white; border-radius: var(--radius); border: 1px solid var(--border);">
    <i class="fa-solid fa-prescription-bottle" style="font-size: 3rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
    <h3>No medicines found matching your criteria</h3>
    <p style="color: var(--text-muted); margin-top: 0.5rem;">Try clearing your search or category filter.</p>
    <a href="/products" class="btn-primary" style="margin-top: 1.5rem;">View All Products</a>
  </div>
<% } else { %>
  <div class="products-grid">
    <% products.forEach(product => { %>
      <div class="product-card">
        <div class="product-image-wrap">
          <a href="/products/<%= product.id %>">
            <img src="<%= product.image_url %>" alt="<%= product.name %>" class="product-image">
          </a>
          <% if (product.badge) { %>
            <span class="badge <%= product.requires_rx ? 'rx-badge' : '' %>"><%= product.badge %></span>
          <% } %>
        </div>
        <div class="product-info">
          <span class="product-brand"><%= product.brand %></span>
          <h3 class="product-name">
            <a href="/products/<%= product.id %>" style="color: inherit;"><%= product.name %></a>
          </h3>
          <p class="product-dosage"><%= product.dosage %> • <%= product.pack_size %></p>
          <div class="product-bottom">
            <div>
              <span class="price">₹<%= product.price %></span>
              <% if (product.original_price) { %>
                <span class="original-price">₹<%= product.original_price %></span>
              <% } %>
            </div>
            <form action="/cart/add" method="POST">
              <input type="hidden" name="productId" value="<%= product.id %>">
              <button type="submit" class="btn-add-cart"><i class="fa-solid fa-cart-plus"></i> Add</button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
